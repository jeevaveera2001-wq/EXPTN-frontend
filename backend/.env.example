# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Cloud Cluster)
MONGODB_URI=
MONGO_URI=

# Authentication Security
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Direct Gmail SMTP Delivery (Google App Password)
SMTP_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_PASSWORD=
GOOGLE_SCRIPT_MAIL_URL=

# Frontend Client URLs & CORS
FRONTEND_URL=https://frontend-blond-iota-kzel6q4tzd.vercel.app
CLIENT_URL=https://frontend-blond-iota-kzel6q4tzd.vercel.app

# Support & Super Admin Contact
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
